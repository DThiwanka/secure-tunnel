{
  "name": "secure-tunnel-monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "Transparent application-layer API gateway tunnel for Express and Node.js clients",
  "scripts": {
    "build": "node init && pnpm --recursive --filter \"@secure-tunnel/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"examples/*/*.ts\" \"examples/*/*.tsx\"",
    "format": "prettier --write \"packages/**/*.ts\" \"examples/**/*.ts\"",
    "docs": "typedoc"
  },
  "keywords": [
    "security",
    "tunnel",
    "gateway",
    "express",
    "api-gateway",
    "encryption",
    "cryptography",
    "replay-protection",
    "compression"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "devDependencies": {
    "@secure-tunnel/client": "workspace:*",
    "@secure-tunnel/compression": "workspace:*",
    "@secure-tunnel/core": "workspace:*",
    "@secure-tunnel/crypto": "workspace:*",
    "@secure-tunnel/express": "workspace:*",
    "@secure-tunnel/logger": "workspace:*",
    "@secure-tunnel/plugins": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "supertest": "^7.0.0",
    "tsup": "^8.0.2",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
