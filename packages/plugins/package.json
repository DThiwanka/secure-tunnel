{
  "name": "@secure-tunnel/plugins",
  "version": "1.0.2",
  "description": "Standard plugins implementation (Encryption, Compression, Logger, Metrics, RateLimit, Tracing, Auth, ReplayProtection) for Secure Tunnel",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "dependencies": {
    "@secure-tunnel/compression": "workspace:*",
    "@secure-tunnel/core": "workspace:*",
    "@secure-tunnel/crypto": "workspace:*",
    "@secure-tunnel/logger": "workspace:*"
  }
}
