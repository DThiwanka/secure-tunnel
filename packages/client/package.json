{
  "name": "@secure-tunnel/client",
  "version": "1.0.2",
  "description": "Client SDK for Secure Tunnel (Fetch, Axios adapter, React hook, Next.js helper)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "dependencies": {
    "@secure-tunnel/compression": "workspace:*",
    "@secure-tunnel/core": "workspace:*",
    "@secure-tunnel/crypto": "workspace:*",
    "@secure-tunnel/plugins": "workspace:*"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "axios": "^1.6.8",
    "react": "^18.3.1"
  }
}
